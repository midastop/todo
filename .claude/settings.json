{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous-commands.js\"",
            "shell": "powershell",
            "timeout": 10,
            "statusMessage": "위험 명령 검사 중..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [{ "type": "command", "command": "npx prettier --write ." }]
      }
    ]
  }
}
